DB_URL=jdbc:postgresql://localhost:5432/vote_system
DB_USERNAME=vote
DB_PASSWORD=vote
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_HEALTH_ENABLED=true
CACHE_DEFAULT_TTL=PT30S
VOTE_STREAM_HEARTBEAT_MS=15000
VOTE_STREAM_TIMEOUT_MS=1800000
VOTE_SIDE_EFFECT_QUEUE_CAPACITY=200
VOTE_SIDE_EFFECT_SHUTDOWN_WAIT_SECONDS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=PT1M
RATE_LIMIT_REGISTER_LIMIT=3
RATE_LIMIT_REGISTER_WINDOW=PT1H
RATE_LIMIT_REFRESH_LIMIT=20
RATE_LIMIT_REFRESH_WINDOW=PT1M
RATE_LIMIT_SOCIAL_START_LIMIT=20
RATE_LIMIT_SOCIAL_START_WINDOW=PT1M
RATE_LIMIT_CREATE_POST_LIMIT=10
RATE_LIMIT_CREATE_POST_WINDOW=PT1H
RATE_LIMIT_VOTE_LIMIT=30
RATE_LIMIT_VOTE_WINDOW=PT1M
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_ISSUER=vote-system
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
CORS_ALLOWED_ORIGINS=http://localhost:3000
REFRESH_COOKIE_NAME=vote_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# Optional Google OpenID Connect and GitHub OAuth2 login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SOCIAL_LOGIN_SUCCESS_URL=http://localhost:3000/
SOCIAL_LOGIN_FAILURE_URL=http://localhost:3000/
OAUTH_SESSION_TIMEOUT=10m
OAUTH_SESSION_COOKIE_NAME=vote_oauth
OAUTH_SESSION_COOKIE_SECURE=false
OAUTH_SESSION_COOKIE_SAME_SITE=Lax

# Provider callback URLs:
# http://localhost:8080/login/oauth2/code/google
# http://localhost:8080/login/oauth2/code/github

# Cross-site HTTPS deployment example:
# CORS_ALLOWED_ORIGINS=https://app.example.com
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAME_SITE=None
# OAUTH_SESSION_COOKIE_SECURE=true
# OAUTH_SESSION_COOKIE_SAME_SITE=None
# SOCIAL_LOGIN_SUCCESS_URL=https://app.example.com/
# SOCIAL_LOGIN_FAILURE_URL=https://app.example.com/
