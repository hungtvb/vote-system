DB_URL=jdbc:postgresql://localhost:5432/vote_system
DB_USERNAME=vote
DB_PASSWORD=vote
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_HEALTH_ENABLED=true
CACHE_DEFAULT_TTL=PT30S
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=PT1M
RATE_LIMIT_REGISTER_LIMIT=3
RATE_LIMIT_REGISTER_WINDOW=PT1H
RATE_LIMIT_REFRESH_LIMIT=20
RATE_LIMIT_REFRESH_WINDOW=PT1M
RATE_LIMIT_CREATE_POST_LIMIT=10
RATE_LIMIT_CREATE_POST_WINDOW=PT1H
RATE_LIMIT_VOTE_LIMIT=30
RATE_LIMIT_VOTE_WINDOW=PT1M
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_ISSUER=vote-system
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
CORS_ALLOWED_ORIGINS=http://localhost:3000
REFRESH_COOKIE_NAME=vote_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
# Cross-site HTTPS deployment example:
# CORS_ALLOWED_ORIGINS=https://app.example.com
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAME_SITE=None
